# Talent Match V6 — copie este archivo como .env (o ejecute: python -m scripts.setup_env)
# NUNCA suba .env al repositorio. No contiene credenciales reales.

ENVIRONMENT=development
ORGANIZATION_NAME=Organización Demo S.A.S.

# Secretos (genere valores nuevos; setup_env lo hace automáticamente)
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Administrador inicial (solo se crea si no existe ningún administrador). Opcional si usa la semilla demo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base de datos: SQLite por defecto. PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/talentmatch
# DATABASE_URL=sqlite:///./data/talentmatch_v6.db

# Red
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173"]
COOKIE_SECURE=false

# IA externa OPCIONAL. Sin claves la aplicación usa el proveedor local.
# AI_PROVIDER=auto | local | anthropic | gemini
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Modo demostración (permite cargar la semilla). En producción: DEMO_MODE=false
DEMO_MODE=true
